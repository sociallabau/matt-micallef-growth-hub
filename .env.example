# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Which client group this deployment shows: "matt-micallef" (default), "sproule", "mcgrath" or "image-property"
DASHBOARD_CLIENT=matt-micallef

# Password to open the dashboard
DASHBOARD_PASSWORD=

# Airtable Personal Access Token (airtable.com/create/tokens)
# Scope: data.records:read  ·  Access: Reports base
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appRabuCzjpb6urjA
AIRTABLE_TABLE_ID=tbl8PjNLUXx0LHTks

# Meta access token with ads_read on every client ad account
# (System User token from Business Settings recommended — it doesn't expire)
META_ACCESS_TOKEN=
META_API_VERSION=v23.0
